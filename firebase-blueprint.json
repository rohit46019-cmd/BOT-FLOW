{
  "entities": {
    "users": {
      "title": "User",
      "description": "Registered user profile and metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier matching auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "description": "User photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email"]
    },
    "bots": {
      "title": "Bot",
      "description": "Bot configuration",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "keywords": {
      "title": "Keyword",
      "description": "Keyword rules for scanning",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "category": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "ownerId"]
    },
    "scannedItems": {
      "title": "ScannedItem",
      "description": "Items found during scanning",
      "type": "object",
      "properties": {
        "content": { "type": "string" },
        "keywordMatch": { "type": "string" },
        "source": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["content", "ownerId"]
    },
    "activityLogs": {
      "title": "ActivityLog",
      "description": "Bot activity logs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action"]
    },
    "settings": {
      "title": "Setting",
      "description": "Application settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "string" },
        "accountId": { "type": "string" }
      },
      "required": ["key", "value", "accountId"]
    },
    "topics": {
      "title": "Topic",
      "description": "Telegram topics",
      "type": "object",
      "properties": {
        "telegramTopicId": { "type": "number" },
        "chatId": { "type": "string" },
        "name": { "type": "string" },
        "accountId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["telegramTopicId", "chatId", "accountId"]
    },
    "blockedTopics": {
      "title": "BlockedTopic",
      "description": "Blocked Telegram topics",
      "type": "object",
      "properties": {
        "telegramTopicId": { "type": "number" },
        "name": { "type": "string" },
        "link": { "type": "string" },
        "accountId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["telegramTopicId", "accountId"]
    },
    "pendingApprovals": {
      "title": "PendingApproval",
      "description": "Messages pending approval",
      "type": "object",
      "properties": {
        "matchedKeyword": { "type": "string" },
        "ruleId": { "type": "string" },
        "messageId": { "type": "number" },
        "chatId": { "type": "string" },
        "topicId": { "type": "number" },
        "topicName": { "type": "string" },
        "status": { "type": "string" },
        "accountId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ruleId", "messageId", "chatId", "status", "accountId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles"
    },
    "/bots/{botId}": {
      "schema": "bots",
      "description": "Global bot list (filterable by owner)"
    },
    "/keywords/{keywordId}": {
      "schema": "keywords",
      "description": "Scanning keywords"
    },
    "/scannedItems/{itemId}": {
      "schema": "scannedItems",
      "description": "Results of scans"
    },
    "/activityLogs/{logId}": {
      "schema": "activityLogs",
      "description": "Audit logs"
    },
    "/settings/{settingId}": {
      "schema": "settings",
      "description": "App settings"
    },
    "/topics/{topicId}": {
      "schema": "topics",
      "description": "Telegram topics"
    },
    "/blockedTopics/{blockedId}": {
      "schema": "blockedTopics",
      "description": "Blocked topics"
    },
    "/pendingApprovals/{approvalId}": {
      "schema": "pendingApprovals",
      "description": "Pending approvals"
    }
  }
}

