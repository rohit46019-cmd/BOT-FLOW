rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Default Deny (Master Gate)
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Security Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for User Entity
    function isValidUser(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('lastLoginAt' in data) || (data.lastLoginAt is string && data.lastLoginAt.size() <= 64));
    }

    // Validation Blueprint for User Settings Entity
    function isValidUserSettings(data, userId) {
      return data.userId is string && data.userId == userId &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 32)) &&
             (!('notificationsEnabled' in data) || data.notificationsEnabled is bool) &&
             (!('activeProfile' in data) || (data.activeProfile is string && data.activeProfile.size() <= 128)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation Blueprint for Activity Log Entity
    function isValidActivityLog(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 128 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 64)) &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2048)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    // Connection Health Check Endpoint
    match /test/connection {
      allow get: if true;
    }

    // Users Collection Root
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Blanket user scrapes are forbidden
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Subcollection: Settings
      match /settings/{settingId} {
        allow get: if isOwner(userId) && isValidId(settingId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(settingId) && isValidUserSettings(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(settingId) && isValidUserSettings(incoming(), userId) &&
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }

      // Subcollection: Activity Logs (Append-Only Audit Stream)
      match /activityLogs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidActivityLog(incoming(), userId);
        allow update: if false; // Logs cannot be mutated after write
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
